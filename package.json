{
  "name": "multi-user-chatbot-simulator",
  "version": "0.5.0",
  "description": "Simulate many users talking to your chatbot, and to each other through it: a browser console with profiles, relations, adapters, scripts and export/import.",
  "keywords": [
    "bot",
    "chatbot",
    "console",
    "multi-user",
    "simulator",
    "testing"
  ],
  "homepage": "https://github.com/hananbenshabat/multi-user-chatbot-simulator#readme",
  "bugs": {
    "url": "https://github.com/hananbenshabat/multi-user-chatbot-simulator/issues"
  },
  "license": "MIT",
  "author": "Hanan Ben Shabat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hananbenshabat/multi-user-chatbot-simulator.git"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "!docs/images",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/chatbot-sim.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./script": {
      "types": "./dist/types/script/index.d.ts",
      "import": "./dist/script.js"
    },
    "./adapters/demo": {
      "types": "./dist/types/adapters/demo.d.ts",
      "import": "./dist/adapters/demo.js"
    },
    "./adapters/http-json": {
      "types": "./dist/types/adapters/http-json.d.ts",
      "import": "./dist/adapters/http-json.js"
    },
    "./style.css": "./dist/chatbot-sim.css",
    "./standalone": "./dist/chatbot-sim.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build --mode standalone && tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "publint": "publint",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run knip && npm run build && npm run publint",
    "echo": "node examples/echo-server.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19.2",
    "react-dom": ">=19.2",
    "react-router": ">=8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings"
    ],
    "*.{json,css,html}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=18"
  }
}
